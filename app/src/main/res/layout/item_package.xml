<?xml version="1.0" encoding="utf-8"?>
<!-- Package item for RecyclerView - Matches React dashboard active package card style -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/spacing_m"
    android:background="@drawable/bg_package_card"
    android:elevation="@dimen/elevation_xs"
    android:gravity="center_vertical"
    android:padding="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Blue-50 rounded icon container -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icon_box_blue"
        android:layout_marginEnd="@dimen/spacing_m">

        <ImageView
            android:layout_width="@dimen/icon_m"
            android:layout_height="@dimen/icon_m"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/blue_600" />
    </FrameLayout>

    <!-- Package Info -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewPackageId"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#TR-849201"
            android:textColor="@color/gray_800"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xxs"
            android:text="İstanbul · 12 May, 14:00"
            android:textColor="@color/gray_500"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <!-- Chevron Right -->
    <ImageView
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:src="@android:drawable/ic_media_play"
        app:tint="@color/gray_300" />
</LinearLayout>

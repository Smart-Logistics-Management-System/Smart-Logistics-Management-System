<?xml version="1.0" encoding="utf-8"?>
<!-- Package List Screen - Matches React: back arrow, filter pills, package cards with status/location/weight -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- ═══════════ HEADER ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_m"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/spacing_m"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/gray_700" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/package_list_title"
            android:textColor="@color/gray_800"
            android:textSize="@dimen/text_header"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════ CONTENT ═══════════ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="80dp">

            <!-- ─── Filter Pills ─── -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_l"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_chip_active"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:paddingVertical="@dimen/spacing_s"
                        android:text="@string/filter_all"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:paddingVertical="@dimen/spacing_s"
                        android:text="@string/filter_current"
                        android:textColor="@color/gray_600"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:paddingVertical="@dimen/spacing_s"
                        android:text="@string/filter_delivered"
                        android:textColor="@color/gray_600"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_s"
                        android:background="@drawable/bg_filter_chip_inactive"
                        android:paddingHorizontal="@dimen/spacing_m"
                        android:paddingVertical="@dimen/spacing_s"
                        android:text="@string/filter_cancelled"
                        android:textColor="@color/gray_600"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- ─── Package Card 1: In Transit ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_package_list_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <!-- Status row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:background="@drawable/bg_timeline_dot_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="IN TRANSIT"
                            android:textColor="@color/blue_600"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="12 May, 14:00"
                        android:textColor="@color/gray_400"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <!-- Package ID -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="TRK9921"
                    android:textColor="@color/gray_800"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <!-- Location & Weight -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İstanbul"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />

                    <View
                        android:layout_width="@dimen/spacing_m"
                        android:layout_height="0dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.5kg"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Package Card 2: Delivered ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_package_list_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:background="@drawable/bg_timeline_dot_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DELIVERED"
                            android:textColor="@color/blue_600"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10 May, 09:30"
                        android:textColor="@color/gray_400"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="TRK8812"
                    android:textColor="@color/gray_800"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ankara"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />

                    <View
                        android:layout_width="@dimen/spacing_m"
                        android:layout_height="0dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.2kg"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Package Card 3: Pending ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_package_list_card"
                android:orientation="vertical"
                android:padding="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/spacing_s">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center_vertical">

                        <View
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:layout_marginEnd="@dimen/spacing_s"
                            android:background="@drawable/bg_timeline_dot_active" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="PENDING"
                            android:textColor="@color/blue_600"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold"
                            android:letterSpacing="0.08" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tomorrow"
                        android:textColor="@color/gray_400"
                        android:textSize="@dimen/text_xs" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_xs"
                    android:text="TRK7734"
                    android:textColor="@color/gray_800"
                    android:textSize="@dimen/text_subtitle"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_myplaces"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="İzmir"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />

                    <View
                        android:layout_width="@dimen/spacing_m"
                        android:layout_height="0dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:src="@android:drawable/ic_menu_send"
                        app:tint="@color/gray_500" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="5.0kg"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>

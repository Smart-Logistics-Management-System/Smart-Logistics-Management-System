<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_m"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/spacing_m"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/gray_700" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Yeni Kargo Ekle"
            android:textColor="@color/gray_800"
            android:textSize="@dimen/text_header"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- FORM -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_l">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gönderici ID"
                android:textColor="@color/gray_700"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etSenderId"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_input_field"
                android:hint="Örn: 1"
                android:inputType="number"
                android:paddingHorizontal="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alıcı ID"
                android:textColor="@color/gray_700"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etReceiverId"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_input_field"
                android:hint="Örn: 2"
                android:inputType="number"
                android:paddingHorizontal="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ağırlık (kg)"
                android:textColor="@color/gray_700"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etWeight"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_input_field"
                android:hint="Örn: 5.5"
                android:inputType="numberDecimal"
                android:paddingHorizontal="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_l" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/error"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/spacing_m" />

            <!-- KAYDET BUTTON -->
            <FrameLayout
                android:id="@+id/btnSaveCargo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/bg_button_blue"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/tvSaveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Kargoyu Kaydet"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_body_large"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/pbLoading"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:visibility="gone"
                    android:indeterminateTint="@color/white" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

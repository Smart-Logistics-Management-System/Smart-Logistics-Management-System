<?xml version="1.0" encoding="utf-8"?>
<!-- Notifications Screen - Matches React: back arrow header, notification cards with blue circle bell icon -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- ═══════════ HEADER ═══════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_xxl"
        android:paddingBottom="@dimen/spacing_m"
        android:background="@color/white">

        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="@dimen/spacing_m"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless">

            <ImageView
                android:layout_width="@dimen/icon_s"
                android:layout_height="@dimen/icon_s"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/gray_700" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_title"
            android:textColor="@color/gray_800"
            android:textSize="@dimen/text_header"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- ═══════════ NOTIFICATIONS LIST ═══════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_l"
            android:paddingBottom="80dp">

            <!-- ─── Notification 1: Paketiniz Yola Çıktı ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_card"
                android:elevation="@dimen/elevation_xs"
                android:gravity="top"
                android:padding="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m">

                <!-- Blue-50 circle with bell icon -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_notif_icon_circle"
                    android:layout_marginEnd="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="@color/blue_600" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Paketiniz Yola Çıktı"
                        android:textColor="@color/gray_800"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="TRK9921 nolu paketiniz transfer merkezinden ayrıldı."
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_xs"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="@dimen/spacing_s" />

                    <!-- Time badge -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_time_badge"
                        android:paddingHorizontal="@dimen/spacing_s"
                        android:paddingVertical="2dp"
                        android:text="2 dakika önce"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ─── Notification 2: Teslimat Onayı ─── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_notif_card"
                android:elevation="@dimen/elevation_xs"
                android:gravity="top"
                android:padding="@dimen/spacing_m"
                android:layout_marginBottom="@dimen/spacing_m">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_notif_icon_circle"
                    android:layout_marginEnd="@dimen/spacing_m">

                    <ImageView
                        android:layout_width="@dimen/icon_s"
                        android:layout_height="@dimen/icon_s"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_popup_reminder"
                        app:tint="@color/blue_600" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teslimat Onayı"
                        android:textColor="@color/gray_800"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_xxs"
                        android:text="TRK8812 nolu paket başarıyla teslim edildi."
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_xs"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="@dimen/spacing_s" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_time_badge"
                        android:paddingHorizontal="@dimen/spacing_s"
                        android:paddingVertical="2dp"
                        android:text="2 saat önce"
                        android:textColor="@color/gray_500"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>

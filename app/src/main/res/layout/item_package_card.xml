<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_package_list_card"
    android:orientation="vertical"
    android:padding="@dimen/spacing_m"
    android:layout_marginBottom="@dimen/spacing_m"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <!-- Status row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/spacing_s">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginEnd="@dimen/spacing_s"
                android:background="@drawable/bg_timeline_dot_active" />

            <TextView
                android:id="@+id/tvCardStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN TRANSIT"
                android:textColor="@color/blue_600"
                android:textSize="@dimen/text_xs"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12 May, 14:00"
            android:textColor="@color/gray_400"
            android:textSize="@dimen/text_xs" />
    </LinearLayout>

    <!-- Package ID -->
    <TextView
        android:id="@+id/tvCardTracking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/spacing_xs"
        android:text="TRK9921"
        android:textColor="@color/gray_800"
        android:textSize="@dimen/text_subtitle"
        android:textStyle="bold" />

    <!-- Location & Weight -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:src="@android:drawable/ic_menu_myplaces"
            app:tint="@color/gray_500" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="İstanbul"
            android:textColor="@color/gray_500"
            android:textSize="@dimen/text_caption" />

        <View
            android:layout_width="@dimen/spacing_m"
            android:layout_height="0dp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="@dimen/spacing_xs"
            android:src="@android:drawable/ic_menu_send"
            app:tint="@color/gray_500" />

        <TextView
            android:id="@+id/tvCardWeight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2.5kg"
            android:textColor="@color/gray_500"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Lojistik" parent="Theme.Material3.Light.NoActionBar">
        <!-- Primary brand color (blue-600) -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color (emerald) -->
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSecondaryVariant">@color/accent_dark</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Tertiary -->
        <item name="colorTertiary">@color/primary_medium</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/white</item>
        <!-- Navigation bar -->
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.Lojistik.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">@dimen/radius_l</item>
        <item name="cardElevation">@dimen/elevation_s</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Outlined Card Style -->
    <style name="Widget.Lojistik.Card.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/radius_m</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/gray_200</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Primary Button -->
    <style name="Widget.Lojistik.Button.Primary" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Tonal Button -->
    <style name="Widget.Lojistik.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/radius_m</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">@dimen/button_height</item>
    </style>

    <!-- Base Text Appearance (required as implicit parent) -->
    <style name="TextAppearance.Lojistik" parent="TextAppearance.Material3.BodyMedium" />

    <!-- Section Header Text -->
    <style name="TextAppearance.Lojistik.SectionHeader">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/gray_500</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <!-- Stat Number -->
    <style name="TextAppearance.Lojistik.StatNumber">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Stat Label -->
    <style name="TextAppearance.Lojistik.StatLabel">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/gray_500</item>
    </style>

</resources>